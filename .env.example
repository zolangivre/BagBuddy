# These defaults work out of the box against the local backend started from the
# bagbuddy-back repo (https://github.com/zolangivre/bagbuddy-back) —
# copy this file to .env and you're set.

# Backend API (api-gateway)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Keycloak (auth) — realm/client are auto-created by the backend's docker compose
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8000/realms/bagbuddy
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=bagbuddy-mobile

# Stripe: nothing to set here. The publishable key is served by the backend
# (stripeConfig on /stripe/graphql), and payment intents go through the gateway
# like every other call. stripe-service stays disabled locally until real test
# keys are set on the backend — see the bagbuddy-back README.
